{
	"name": "dacia-over-reacts",
	"version": "0.1.0",
	"private": true,
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"dependencies": {
		"@davidanddacia/react-ui-components": "github:davidanddacia/react-ui-components",
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@reduxjs/toolkit": "2.12.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-redux": "9.3.0",
		"react-router": "8.3.0",
		"sass": "1.102.0",
		"vite": "8.2.1"
	},
	"devDependencies": {
		"@cspell/eslint-plugin": "10.0.1",
		"@eslint/eslintrc": "3.3.6",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.62.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "7.0.0",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.3",
		"@types/jest": "30.0.0",
		"@types/node": "26.1.2",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@typescript-eslint/eslint-plugin": "8.66.0",
		"@typescript-eslint/parser": "8.66.0",
		"@vitejs/plugin-react": "6.0.5",
		"cssnano": "8.0.4",
		"eslint": "10.8.0",
		"eslint-plugin-perfectionist": "5.10.1",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-unicorn": "73.0.0",
		"husky": "9.1.7",
		"jsdom": "30.0.1",
		"postcss": "8.5.26",
		"postcss-import": "16.1.1",
		"postcss-preset-env": "11.3.2",
		"postcss-scss": "4.0.9",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"scripts": {
		"build": "vite build",
		"dev": "vite",
		"e2e:debug": "playwright test --debug",
		"e2e:headed": "playwright test --headed",
		"e2e:report": "playwright show-report",
		"e2e": "playwright test",
		"format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
		"lint": "eslint --fix \"src/**/*.{js,ts,tsx}\" \"tests/**/*.{js,ts,tsx}\" \"vite.config.ts\"",
		"prepare": "chmod +x .husky/*",
		"preview": "vite preview",
		"test:coverage": "vitest --coverage",
		"test:ui": "vitest --ui",
		"test:watch": "vitest --watch",
		"test": "vitest"
	}
}
